#!/bin/sh
set -u
. /payload/plan

say() { echo "TETHER: $*"; }
fail() { say "FAILED: $*"; finish 1; }
finish() {
    say "DONE $1"
    stick=$(blkid -t LABEL=BANDE -o device | grep "^/dev/sd" | head -1)
    if [ -n "$stick" ]; then
        mkdir -p /mnt/stick
        mount -t exfat "$stick" /mnt/stick && mkdir -p /mnt/stick/tether &&
            cp /tmp/tether.log "/mnt/stick/tether/$MODE-$(date +%Y%m%d-%H%M%S).log"
        umount /mnt/stick
    fi
    exit "$1"
}
part() { sfdisk -d "$DISK" | grep "name=\"$1\"" | cut -d' ' -f1; }

for _ in $(seq 30); do [ -b "$DISK" ] && break; sleep 1; done
[ -b "$DISK" ] || fail "no $DISK"
[ "$(cat "/sys/block/${DISK##*/}/queue/logical_block_size")" = "$SECTOR_SIZE" ] ||
    fail "$DISK does not have the planned $SECTOR_SIZE-byte sectors"
say "before:"
sfdisk -d "$DISK"
esp=$(part "Bande ESP")
root=$(part "Bande Linux")

case "$MODE" in
install)
    if [ -z "$esp" ] && [ -z "$root" ]; then
        [ "$(sfdisk -d "$DISK" | grep "^/dev/" | sha256sum | cut -d" " -f1)" = "$EXPECT" ] ||
            fail "the partition table is not the one the plan was made for"
        printf '%s\n' \
            "start=$ESP_START, size=$ESP_SIZE, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, uuid=$ESP_UUID, name=\"Bande ESP\"" \
            "start=$ROOT_START, size=$ROOT_SIZE, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, uuid=$ROOT_PARTUUID, name=\"Bande Linux\"" |
            sfdisk --append "$DISK" || fail "sfdisk"
        mdev -s
        esp=$(part "Bande ESP")
        root=$(part "Bande Linux")
    fi
    [ -n "$esp" ] && [ -n "$root" ] || fail "partitions missing after partitioning"
    sfdisk -d "$DISK" | grep "^$esp " | grep -qi "uuid=$ESP_UUID" || fail "$esp is not the planned ESP"
    sfdisk -d "$DISK" | grep "^$root " | grep -qi "uuid=$ROOT_PARTUUID" || fail "$root is not the planned root"
    say "writing $esp and $root"
    zstd -dc /payload/esp.img.zst | dd of="$esp" bs=4M conv=fsync 2>&1 || fail "writing $esp"
    zstd -dc /payload/root.img.zst | dd of="$root" bs=4M conv=fsync 2>&1 || fail "writing $root"
    sync
    ;;
remove)
    for p in $root $esp; do
        sfdisk --delete "$DISK" "${p##*p}" || fail "deleting $p"
    done
    ;;
*)
    fail "unknown mode $MODE"
    ;;
esac
say "after:"
sfdisk -d "$DISK"
finish 0
