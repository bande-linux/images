    fi
    if [ -x "$system/etc/kernel/postinst.d/zz-update-unboot" ]; then
        mkdir -p "$esp/unboot"
        touch "$esp/.builder"
        chroot "$system" /etc/kernel/postinst.d/zz-update-unboot "$version"
        rm -f "$esp/.builder"
    fi
    umount "$system/boot/efi" "$system/sys" "$system/proc" "$system/dev"
}

format_root() {
    local device=$1 reencrypt=$2
    printf bande-provisional | cryptsetup luksFormat -q --type luks2 --label BANDE-ROOT --pbkdf pbkdf2 --pbkdf-force-iterations 1000 --key-file - "$device"
    echo "{\"type\":\"bande-provisional\",\"keyslots\":[],\"reencrypt\":$reencrypt}" | cryptsetup token import --token-id 0 "$device"
    printf bande-provisional | cryptsetup open --key-file - "$device" "$mapper"
    mkfs.btrfs -q -f -L bande "/dev/mapper/$mapper"
}

release() {
    local target=$1
    if [ -d "$target" ]; then
        umount -R "$target/esp" 2>/dev/null || true
        umount -R "$target/top" 2>/dev/null || true
    fi
    cryptsetup close "$mapper" 2>/dev/null || true
}

populate() {
    local device=$1 image=$2 esp=$3 target=$4 image_partuuid=$5
    local id fs_uuid luks_uuid esp_uuid
    step copy
    id=$(write_system "$image" "$target" | tail -1)
    fs_uuid=$(blkid -s UUID -o value "/dev/mapper/$mapper")
    luks_uuid=$(cryptsetup luksUUID "$device")
    esp_uuid=${ESP_UUID:-$(findmnt -no UUID "$esp" 2>/dev/null || true)}
    write_fstab "$target/top/@system/$id" "$fs_uuid" "$esp_uuid"
    step boot
    write_boot "$target/top/@system/$id" "$id" "$fs_uuid" "$luks_uuid" "$image_partuuid" "$esp"
    sync
}

install_disk() {
    local disk=$1 target=/run/bande-install
    local live
    live=$(live_image)
    [ -b "$disk" ] || fail "No such disk."
    [ "$(lsblk -no PKNAME "$live")" != "$(basename "$disk")" ] || fail "This disk holds the running system."
    trap 'release "$target"' EXIT
    mkdir -p "$target/esp"
    step partition
    wipefs -q -a "$disk"
    sfdisk -q "$disk" <<EOT
label: gpt
size=$((esp_bytes / 512)), type=U, name=EFI
size=$((recovery_bytes / 512)), type=L, name=BANDE-RECOVERY
type=L, name=BANDE-ROOT
EOT
    udevadm settle
    local esp_part recovery_part root_part
    esp_part=$(part_of "$disk" 1)
    recovery_part=$(part_of "$disk" 2)
    root_part=$(part_of "$disk" 3)
    step recovery
    dd if="$live" of="$recovery_part" bs=4M conv=fsync status=none
    step format
    mkfs.vfat -F 32 -n BANDE-EFI "$esp_part" >/dev/null
    format_root "$root_part" false
    mount "$esp_part" "$target/esp"
    ESP_UUID=$(blkid -s UUID -o value "$esp_part")
    populate "$root_part" "$recovery_part" "$target/esp" "$target" "$(blkid -s PARTUUID -o value "$recovery_part")"
    step done
}

reinstall() {
    local target=/run/bande-install
    local image root_part esp_part recovery_uuid
    image=$(live_image)
    root_part=$(readlink -f /dev/disk/by-partlabel/BANDE-ROOT)
    [ -b "$root_part" ] || fail "No Bande system found."
    trap 'release "$target"' EXIT
    mkdir -p "$target/esp"
    IFS= read -r line || true
    if ! printf %s "$line" | cryptsetup open --key-file - "$root_part" "$mapper"; then
        fail "Wrong password."
    fi
    unset line
    local disk
    disk=/dev/$(lsblk -no PKNAME "$root_part")
    esp_part=$(sfdisk -d "$disk" | awk -F'[ :]+' '/type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B/ { print $1; exit }')
    [ -n "$esp_part" ] || fail "No EFI partition found."
    mount "$esp_part" "$target/esp"
    ESP_UUID=$(blkid -s UUID -o value "$esp_part")
    recovery_uuid=$(blkid -s PARTUUID -o value /dev/disk/by-partlabel/BANDE-RECOVERY)
    populate "$root_part" "$image" "$target/esp" "$target" "$recovery_uuid"
    step done
}

with_system() {
    local target=/run/bande-install root_part esp_part
    root_part=$(readlink -f /dev/disk/by-label/BANDE-ROOT)
    [ -b "$root_part" ] || fail "No Bande system found."
    trap 'release "$target"' EXIT
    mkdir -p "$target/esp"
    IFS= read -r line || true
    if ! printf %s "$line" | cryptsetup open --key-file - "$root_part" "$mapper"; then
        fail "Wrong password."
    fi
    unset line
    esp_part=$(find_esp "$root_part")
    [ -n "$esp_part" ] || fail "No EFI partition found."
    mount "$esp_part" "$target/esp"
    BANDE_ESP=$target/esp BANDE_ROOT_DEVICE=/dev/mapper/$mapper "$@"
}

image() {
    local device=$1 recovery=$2 target=$3
    trap 'release "$target"' EXIT
    mkdir -p "$target"
    format_root "$device" true
    populate "$device" "$recovery" "$ESP_DIR" "$target" "${RECOVERY_PARTUUID:-}"
}

case "${1:-}" in
install) install_disk "$2" ;;
reinstall) reinstall ;;
versions) with_system bande-system list | sed 's/^/version /' ;;
restore) with_system bande-system restore "$2" ;;
image) image "$2" "$3" "$4" ;;
release) release "$2" ;;
*) fail "unknown command ${1:-}" ;;
esac
