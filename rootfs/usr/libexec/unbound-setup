#!/bin/sh
set -eu

dir=/boot/efi/unbound/setup

value() {
    if [ -f "$dir/$1" ]; then cat "$dir/$1"; fi
}

user=$(value user)
if [ -n "$user" ]; then
    if id "$user" >/dev/null 2>&1; then
        if [ "$(id -u "$user")" -lt 1000 ]; then
            echo "unbound-setup: $user is a system account" >&2
            exit 1
        fi
    else
        useradd -m -s /bin/bash -G sudo,video,render,input,audio "$user"
    fi
    password=$(value password)
    if [ -n "$password" ]; then
        printf '%s:%s\n' "$user" "$password" | chpasswd
    fi
    if [ -s "$dir/authorized_keys" ]; then
        home=$(getent passwd "$user" | cut -d: -f6)
        install -d -m 0700 -o "$user" -g "$user" "$home/.ssh"
        install -m 0600 -o "$user" -g "$user" "$dir/authorized_keys" "$home/.ssh/authorized_keys"
    fi
    if ! grep -q '^\[initial_session\]' /etc/greetd/config.toml; then
        printf '\n[initial_session]\ncommand = "unbound-compositor"\nuser = "%s"\n' "$user" >> /etc/greetd/config.toml
    fi
fi

ssid=$(value wifi-ssid)
if [ -n "$ssid" ]; then
    psk=$(value wifi-psk)
    connection=$(mktemp)
    if [ -n "$psk" ]; then
        nmcli --offline connection add type wifi con-name "$ssid" ssid "$ssid" \
            wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$psk" > "$connection"
    else
        nmcli --offline connection add type wifi con-name "$ssid" ssid "$ssid" > "$connection"
    fi
    install -m 0600 "$connection" "/etc/NetworkManager/system-connections/$(cat /proc/sys/kernel/random/uuid).nmconnection"
    rm -f "$connection"
fi

for secret in password wifi-psk; do
    if [ -f "$dir/$secret" ]; then shred -u "$dir/$secret"; fi
done
rm -rf "$dir"
